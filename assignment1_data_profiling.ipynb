        "reference_date = pd.Timestamp(\"2026-11-01\")\n",
        "\n",
        "if \"released_date\" in df.columns:\n",
        "\n",
        "    df[\"age_since_release_days\"] = (\n",
        "        reference_date - df[\"released_date\"]\n",
        "    ).dt.days\n",
        "\n",
        "    # Negative ages indicate release dates after the reference date\n",
        "    future_release = df[\"age_since_release_days\"] < 0\n",
        "\n",
        "    print(\n",
        "        \"\\nRelease dates after the reference date:\",\n",
