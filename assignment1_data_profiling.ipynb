      "source": [
        "# ==========================================\n",
        "# 5. PII & BIAS MITIGATION\n",
        "# ==========================================\n",
        "\n",
        "def sanitize_pii(text):\n",
        "    \"\"\"Redacts potential emails or Malaysian IC numbers from text columns.\"\"\"\n",
        "    if not isinstance(text, str):\n",
        "        return text\n",
        "    text = re.sub(r'[\\w\\.-]+@[\\w\\.-]+\\.\\w+', '[REDACTED_EMAIL]', text)\n",
        "    text = re.sub(r'\\b\\d{6}-\\d{2}-\\d{4}\\b', '[REDACTED_IC]', text)\n",
        "    return text\n",
        "\n",
        "if 'purpose' in df.columns:\n",
        "    df['purpose_clean'] = df['purpose'].apply(sanitize_pii)\n",
        "    print(\"\\nPII Sanitization successfully applied to 'purpose' text column.\")\n",
        "\n",
        "if 'operating_system' in df.columns:\n",
        "    print(\"\\nClass / Group Balance Assessment (%):\")\n",
        "    print((df['operating_system'].value_counts(normalize=True) * 100).round(2))"
      ]
