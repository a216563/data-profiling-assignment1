        "        \"The released_date column is missing.\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 9. DETECT OUTLIERS USING THE IQR METHOD\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "# Identify unusual app ages without deleting the original observations.\n",
        "# Keep the original values and create a separate capped column.\n",
        "\n",
        "if (\n",
        "    \"age_since_release_days\" in df.columns\n",
        "    and df[\"age_since_release_days\"].notna().sum() > 0\n",
        "):\n",
        "\n",
        "    Q1 = df[\"age_since_release_days\"].quantile(0.25)\n",
        "    Q3 = df[\"age_since_release_days\"].quantile(0.75)\n",
        "\n",
        "    IQR = Q3 - Q1\n",
        "\n",
        "    lower_bound = max(0, Q1 - 1.5 * IQR)\n",
