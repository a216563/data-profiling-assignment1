        "duplicates_before = int(df.duplicated().sum())\n",
        "\n",
        "print(\"\\nExact duplicate rows found:\", duplicates_before)\n",
        "\n",
        "df = df.drop_duplicates().copy()\n",
        "\n",
        "print(\"Dataset shape after removing exact duplicates:\", df.shape)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. CALCULATE APPLICATION LIFESPAN\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "# Lifespan is only confirmed when both release and shutdown dates exist.\n",
        "# Apps with no valid shutdown date will have missing confirmed lifespan.\n",
        "\n",
        "if \"released_date\" in df.columns and \"shutdown\" in df.columns:\n",
        "\n",
        "    df[\"confirmed_lifespan_days\"] = (\n",
        "        df[\"shutdown\"] - df[\"released_date\"]\n",
        "    ).dt.days\n",
        "\n",
        "    # Defensive check: invalid negative lifespans should not remain\n",
        "    negative_lifespan = df[\"confirmed_lifespan_days\"] < 0\n",
        "\n",
        "    print(\n",
        "        \"\\nNegative confirmed lifespans found:\",\n",
        "        int(negative_lifespan.sum())\n",
        "    )\n",
        "\n",
        "    df.loc[\n",
        "        negative_lifespan,\n",
